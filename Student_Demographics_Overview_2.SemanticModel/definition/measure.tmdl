table Measure
    lineageTag: 1bf3466f-0021-4e99-aac3-0dbce251eebc

    measure 'Attendance Percentage - Split 1' =

            Var A = VALUE(LEFT([Attendance Percentage], LEN([Attendance Percentage]) - 1))
            return A
        lineageTag: 36011152-26ae-4df7-a470-00d16859ab11

    measure 'Student count' =

            Var A = DISTINCTCOUNT([Student ID])
            return A+0 
        lineageTag: 06c4cfe2-c798-4886-8b77-d1f7671a9964

    measure 'Tutors count' =

            Var A = DISTINCTCOUNT([tutor_id])
            return A+0 
        lineageTag: bff2d841-d517-4156-862d-baef15fd7b9a

    measure 'Course offered' =

            Var A = DISTINCTCOUNT([Course id (course)])
            return A+0 
        lineageTag: 67e3c7a6-dfb7-4146-a38d-d7962a935727

    measure 'Avg Attendance %' =

            Var A = AVERAGE([Attendance Percentage - Split 1])
            return A+0 
        lineageTag: 209d1954-0391-4a00-b480-c9a206192721

    measure 'Avg credits' =

            Var A = AVERAGE([credits])
            return A+0 
        lineageTag: ec794074-f9f3-463b-a72b-4992b873a068
    column Column
        dataType: double
        formatString: #,0.00%;-#,0.00%;#,0.00%
        lineageTag: b06e547d-ae89-48ef-9101-a36ed60310f6
        summarizeBy: none
        isNameInferred
        sourceColumn: [Column]

        annotation SummarizationSetBy = User

    partition Measure = calculated
        mode: import
        source = Row("Column", BLANK())

