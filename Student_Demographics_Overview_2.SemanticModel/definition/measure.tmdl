table Measure
    lineageTag: ddd8187a-b438-4626-adef-6a5687ae13cb

    measure 'Attendance Percentage - Split 1' =

            Var A = VALUE(LEFT([Attendance Percentage], LEN([Attendance Percentage]) - 1))
            return INT(A)
        lineageTag: 43679896-8ceb-42cf-9531-10d47d6606ec

    measure 'Student count' =

            Var A = DISTINCTCOUNT([Student ID])
            return A+0 
        lineageTag: e4e24344-1097-481c-ae40-24e78e5a7d26

    measure 'Tutors count' =

            Var A = DISTINCTCOUNT([tutor_id])
            return A+0 
        lineageTag: 4e6982c6-f76f-4f7f-be68-5bec2e6bdf13

    measure 'Course offered' =

            Var A = DISTINCTCOUNT([Course id (course)])
            return A+0 
        lineageTag: c3d36706-d8fc-4933-8bef-27dcc5feb008

    measure 'Avg Attendance %' =

            Var A = AVERAGE([Attendance Percentage - Split 1])
            return A+0 
        lineageTag: 898f7e3c-be6b-41cd-a580-662dafd756fc

    measure 'Avg credits' =

            Var A = AVERAGE([credits])
            return A+0 
        lineageTag: 19e48a55-6571-40b5-8f00-f4ac4f434f17
    column Column
        dataType: double
        formatString: #,0.00%;-#,0.00%;#,0.00%
        lineageTag: b06e547d-ae89-48ef-9101-a36ed60310f6
        summarizeBy: none
        isNameInferred
        sourceColumn: [Column]

        annotation SummarizationSetBy = User

    partition Measure = calculated
        mode: import
        source = Row("Column", BLANK())

    annotation PBI_Id = 35e43472b79c47efb9bf240e6d624b06
    
