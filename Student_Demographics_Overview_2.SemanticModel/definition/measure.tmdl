"\n    table 'Measure Table'\n\t     lineageTag: f2d37e60-006b-475a-b49d-ebca81320cc8  \n    \nmeasure 'Attendance Percentage - Split 1' =\n\n    \n    Var A = VALUE(LEFT([Attendance Percentage], LEN([Attendance Percentage]) - 1))\n\n    return INT(A) \n\n lineageTag: 6cd113fa-bccf-4827-b4b2-a511f0eaeb36\nmeasure 'Student count' =\n\n    \n    Var A = DISTINCTCOUNT([Student ID])\n\n    return A+0 \n\n lineageTag: 285a53cb-a848-4e71-9f00-603249703d92\nmeasure 'Tutors count' =\n\n    \n    VAR A = DISTINCTCOUNT([tutor_id])\n\n    RETURN A+0\n\n lineageTag: ffce8ad4-2349-4667-9178-0adf9104e5ed\nmeasure 'Course offered' =\n\n    \n    Var A = DISTINCTCOUNT([Course id (course)])\n\n    return A+0 \n\n lineageTag: 6be6a7f9-af91-44d1-877c-24c5481f2222\nmeasure 'Avg Attendance %' =\n\n\n\nVar A = AVERAGE([Attendance Percentage - Split 1])\n\nreturn A+0 \n\n lineageTag: e05b18ec-b9f9-4ae2-9945-df5c5cfa010d\nmeasure 'Avg credits' =\n\n\n\nVar A = AVERAGE([credits])\n\nreturn A+0 \n\n lineageTag: 0130c6ee-fa38-4a28-b00f-50468a7c0893\n    column Column\n\t\tdataType: double\n\t\tformatString: #,0.00%;-#,0.00%;#,0.00%\n\t\tlineageTag: b06e547d-ae89-48ef-9101-a36ed60310f6\n\t\tsummarizeBy: none\n\t\tisNameInferred\n\t\tsourceColumn: [Column]\n\n\t\tannotation SummarizationSetBy = User\n\n\tpartition 'Measure Table' = calculated\n\t\tmode: import\n\t\tsource = Row(\"Column\", BLANK())\n\n\tannotation PBI_Id = 35e43472b79c47efb9bf240e6d624b06\n    "